# Generate a secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
POSTGRES_PASSWORD=replace-with-a-strong-database-password
FRONTEND_ORIGIN=http://localhost:3000
SECURE_COOKIES=false
AI_PROVIDER=mock
MODEL_API_KEY=
META_MODEL=meta-models/muse-spark-open-1026

# Explicit approval is required before enabling chargeable inference.
META_ENABLED=false
META_HOST=baseten
META_BASE_URL=https://inference.baseten.co/v1
# Direct Meta alternative: META_HOST=meta, META_MODEL=muse-spark-1.3
BASETEN_API_KEY=
# Zero budgets fail closed. Set deliberately only after test-call approval.
META_REQUEST_BUDGET=0
META_TOKEN_BUDGET=0
META_SESSION_REQUEST_LIMIT=10
META_MAX_OUTPUT_TOKENS=800
META_USAGE_DB=meta_usage.db
# Reservations persist; deleting this DB resets the local accounting.
# These limits do not enforce the provider's promotional-credit balance.
